# The libmagic sources are built from the submodule, so the sdist must carry them.
graft third_party/file
prune third_party/file/.git
prune third_party/file/autom4te.cache
exclude third_party/file/.git

# src/static_magic/magic.mgc is included (via package_data): the sdist command
# compiles it fresh, and every wheel built from the sdist ships that copy.
global-exclude *.so *.o *.lo *.la *.a *.pyc
